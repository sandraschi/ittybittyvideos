{
  "manifest_version": "0.2",
  "name": "videogen-mcp",
  "version": "0.2.0",
  "description": "AI-powered short video generation MCP server",
  "author": { "name": "Sandra Schipal" },
  "server": {
    "type": "python",
    "entry_point": "run_server.py",
    "mcp_config": {
      "command": "uv",
      "args": ["run","--directory","${PWD}","run_server.py"],
      "env": {
        "PYTHONPATH": "${PWD}/src",
        "PYTHONUNBUFFERED": "1"
      }
    }
  },
  "tools": [
    { "name": "videogen_help", "description": "videogen_help" },
    { "name": "videogen_generate", "description": "videogen_generate" },
